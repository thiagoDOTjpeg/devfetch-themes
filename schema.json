{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevFetch Theme",
  "type": "object",
  "required": [
    "id", "label", "author",
    "bg", "surface", "border", "accent",
    "blue", "green", "purple", "orange", "yellow",
    "text", "muted",
    "artFill", "artOpacity",
    "heat", "dots",
    "crosshatch", "ornate"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique theme identifier (kebab-case)"
    },
    "label": {
      "type": "string",
      "description": "Display name shown in the theme picker"
    },
    "author": {
      "type": "string",
      "description": "GitHub username or org of the theme author"
    },
    "bg": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "surface": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "border": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "blue": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "green": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "purple": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "orange": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "yellow": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "muted": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "artFill": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "artOpacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "heat": {
      "type": "array",
      "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
      "minItems": 4,
      "maxItems": 4,
      "description": "Heatmap gradient: [low, mid, high, max]"
    },
    "dots": {
      "type": "array",
      "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
      "minItems": 3,
      "maxItems": 3,
      "description": "Titlebar dots: [close, minimize, maximize]"
    },
    "crosshatch": {
      "type": "boolean",
      "description": "Enable diagonal crosshatch overlay"
    },
    "ornate": {
      "type": "boolean",
      "description": "Enable double borders, diamond corners and centered headers"
    }
  }
}
